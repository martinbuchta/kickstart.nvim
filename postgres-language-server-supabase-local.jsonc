{
  "$schema": "https://pg-language-server.com/latest/schema.json",
  "db": {
    "connectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable",
    "connTimeoutSecs": 10,
    "allowStatementExecutionsAgainst": ["127.0.0.1/*", "localhost/*"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "typecheck": {
    "enabled": true
  },
  "format": {
    "enabled": true,
    "keywordCase": "lower"
  }
}
